# Mascarenhas Hub — variáveis de ambiente
# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings -> API). Sem elas, o app abre oferecendo o Modo Local (BroadcastChannel).

# URL do projeto Supabase, ex: https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Chave pública "anon" (pode ficar no frontend; a segurança é feita via RLS + RPCs SECURITY DEFINER)
VITE_SUPABASE_ANON_KEY=

# Opcional: caminho base para deploy em subpasta (ex: GitHub Pages => /mascarenhas-hub/)
# VITE_BASE_PATH=/
